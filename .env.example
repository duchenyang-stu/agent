# Copy this file to agent/.env, then fill in your real values.
# Do not commit agent/.env if it contains a real API key.

# Current code supports the OpenAI-compatible Chat Completions protocol.
# DeepSeek, OpenAI, vLLM, and some local servers can expose this style of API.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional. Usually derived from LLM_BASE_URL.
# LLM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions

MAX_STEPS=6
# Retries after the first request. 2 means at most 3 total attempts.
MAX_API_RETRIES=2
# Exponential backoff starts here: 0.5s, 1s, 2s, ...
RETRY_BASE_DELAY=0.5
# Stop the run after this many failed tool calls.
MAX_TOOL_ERRORS=3
LLM_API_TIMEOUT=60
SHOW_PROVIDER_META=1

# Backward-compatible names also still work:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
