# Copy this file to agent/.env, then fill in your real values.
# Do not commit agent/.env if it contains a real API key.

# Current code supports the OpenAI-compatible Chat Completions protocol.
# DeepSeek, OpenAI, vLLM, and some local servers can expose this style of API.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional. Usually derived from LLM_BASE_URL.
# LLM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions

MAX_STEPS=6
SHOW_PROVIDER_META=1

# Backward-compatible names also still work:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
